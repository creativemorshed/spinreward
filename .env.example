# ===== Supabase (Project Settings → API) =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. কখনও NEXT_PUBLIC_ prefix দেবেন না, GitHub-এও commit করবেন না।
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# QR কোডে ও ইমেইলের লিংকে যে ডোমেইন বসবে (শেষে / ছাড়া)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ===== অ্যান্টি-ফ্রড (ঐচ্ছিক) =====
# IP হ্যাশের সল্ট — একটি লম্বা এলোমেলো স্ট্রিং দিন (না দিলে SERVICE_ROLE_KEY ব্যবহার হয়)।
# ⚠️ পরে বদলালে আগের IP-হ্যাশ আর মিলবে না (শুধু চলমান দিনের সীমা রিসেট হবে)।
IP_HASH_SALT=
# এক IP থেকে এক রেস্টুরেন্টে দিনে সর্বোচ্চ স্পিন (ডিফল্ট ১০০; রেস্টুরেন্টের WiFi-তে সবাই এক IP, তাই উদার)
MAX_SPINS_PER_IP_PER_DAY=100
# এক IP থেকে মিনিটে সর্বোচ্চ অনুরোধ (ডিফল্ট ৬০)
MAX_REQUESTS_PER_IP_PER_MINUTE=60

# ===== মেয়াদ-রিমাইন্ডার ইমেইল =====
# Vercel Cron এই মান Authorization: Bearer হিসেবে পাঠায়। একটি লম্বা এলোমেলো স্ট্রিং দিন।
# সেট না থাকলে /api/cron/reminders বন্ধ (503) থাকে।
CRON_SECRET=
# https://resend.com → API Keys; EMAIL_FROM-এর ডোমেইন Resend-এ ভেরিফাই করা থাকতে হবে
RESEND_API_KEY=
EMAIL_FROM=SpinReward <noreply@your-domain.com>

# ===== মালিককে দেখানোর পেমেন্ট নম্বর (নবায়নের সময়) =====
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=
PAYMENT_ROCKET_NUMBER=
PAYMENT_BANK_INFO=
